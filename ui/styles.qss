
/* ==============================================================================
   RANSOMGUARD EDR GLOBAL ENTERPRISE DARK NAVY STYLESHEET
   ============================================================================== */

QMainWindow {
    background-color: #070B16;
}

QWidget {
    font-family: "Inter", "Segoe UI", -apple-system, sans-serif;
    color: #F4F7FF;
    font-size: 13px;
    background: transparent;
}

QStackedWidget {
    background-color: #090F1C;
}

/* Scroll Canvas Pages */
QWidget#scrollContent, QWidget#scanScrollContent, QWidget#historyScrollContent, 
QWidget#settingsScrollContent, QWidget#reportsScrollContent, QWidget#aboutScrollContent {
    background-color: #090F1C;
}

QScrollArea {
    border: none;
    background-color: #090F1C;
}

/* ------------------------------------------------------------------------------
   SIDEBAR NAVIGATION
   ------------------------------------------------------------------------------ */
QFrame#sidebar {
    background-color: #070B16;
    border-right: 1px solid #1A2940;
    min-width: 230px;
    max-width: 230px;
}

QLabel#sidebarTitle {
    font-size: 16px;
    font-weight: 800;
    color: #F4F7FF;
    padding: 18px 14px;
    border-bottom: 1px solid #1A2940;
    background: #070B16;
    letter-spacing: 1px;
}

QPushButton.sidebarButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-left: 4px solid transparent;
    color: #71809A;
    text-align: left;
    padding: 11px 16px;
    font-size: 13px;
    font-weight: 600;
    border-radius: 6px;
    margin: 3px 10px;
}

QPushButton.sidebarButton:hover {
    background-color: #111A2B;
    color: #F4F7FF;
    border: 1px solid #21334D;
    border-left: 4px solid #168BFF;
}

QPushButton.sidebarButton:checked {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #0E274D, stop:1 #143870);
    color: #FFFFFF;
    font-weight: bold;
    border: 1px solid #355B8A;
    border-left: 5px solid #168BFF;
}

/* ------------------------------------------------------------------------------
   TOPBAR HEADER
   ------------------------------------------------------------------------------ */
QFrame#topbar {
    background-color: #070B16;
    border-bottom: 1px solid #1A2940;
    min-height: 58px;
    max-height: 58px;
}

QLabel#topbarTitle {
    font-size: 18px;
    font-weight: 800;
    color: #F4F7FF;
    padding-left: 20px;
    letter-spacing: 0.5px;
}

/* ------------------------------------------------------------------------------
   CARDS & PANELS (NATURALLY BLENDED DARK NAVY SURFACES)
   ------------------------------------------------------------------------------ */
QFrame.metricCard, QFrame#socAlertsCard, QFrame#socActivityCard, QFrame#dashHeaderCard, 
QFrame#endpointStatusCard, QFrame#socPulseCard, QFrame#existingScanCard, QFrame.cardFrame, 
QFrame.panelFrame, QFrame#clickableAlertFrame, QFrame#driveCard, QFrame#usbDeviceCard, 
QFrame#imageScanCard, QFrame#settingsSectionCard, QFrame#scanEvidenceCard, 
QFrame#investigationHeaderCard, QFrame#investigationSummaryCard, 
QFrame#investigationEvidenceCard, QFrame#investigationTimelineCard, 
QFrame#scanEmptyStateContainer, QFrame.socPanel {
    background-color: #0D1422;
    border: 1px solid #1A2940;
    border-radius: 8px;
    padding: 12px;
}

QFrame.metricCard:hover, QFrame#socAlertsCard:hover, QFrame#socActivityCard:hover, 
QFrame#endpointStatusCard:hover, QFrame.cardFrame:hover, QFrame.panelFrame:hover, 
QFrame#clickableAlertFrame:hover, QFrame#driveCard:hover, QFrame#usbDeviceCard:hover,
QFrame#settingsSectionCard:hover {
    border-color: #21334D;
    background-color: #111A2B;
}

QLabel.cardValue {
    font-size: 24px;
    font-weight: bold;
    color: #F4F7FF;
}

QLabel.cardTitle {
    font-size: 11px;
    color: #71809A;
    font-weight: bold;
    letter-spacing: 0.5px;
}

/* ------------------------------------------------------------------------------
   STATUS BADGES
   ------------------------------------------------------------------------------ */
QLabel.statusBadge {
    border-radius: 4px;
    padding: 3px 8px;
    font-weight: bold;
    font-size: 11px;
}

QLabel.badgeLow {
    background-color: rgba(22, 139, 255, 0.15);
    color: #38A8FF;
    border: 1px solid rgba(22, 139, 255, 0.4);
}

QLabel.badgeMedium {
    background-color: rgba(255, 184, 77, 0.15);
    color: #FFB84D;
    border: 1px solid rgba(255, 184, 77, 0.4);
}

QLabel.badgeHigh {
    background-color: rgba(255, 77, 103, 0.15);
    color: #FF4D67;
    border: 1px solid rgba(255, 77, 103, 0.4);
}

QLabel.badgeCritical {
    background-color: rgba(255, 77, 103, 0.25);
    color: #FF4D67;
    border: 1px solid #FF4D67;
}

/* ------------------------------------------------------------------------------
   GLOBAL TABLES (DARK NAVY WITH CRISP BLUE HIGHLIGHTS)
   ------------------------------------------------------------------------------ */
QTableView, QTableWidget {
    background-color: #0D1422;
    border: 1px solid #1A2940;
    gridline-color: #1A2940;
    border-radius: 8px;
    outline: none;
    color: #F4F7FF;
    selection-background-color: #17233A;
    selection-color: #FFFFFF;
}

QTableView::item, QTableWidget::item {
    padding: 8px 12px;
    border-bottom: 1px solid #1A2940;
}

QTableView::item:selected, QTableWidget::item:selected {
    background-color: #17233A;
    color: #FFFFFF;
    border-left: 3px solid #168BFF;
    border-bottom: 1px solid #1A2940;
    font-weight: 600;
}

QTableView::item:hover, QTableWidget::item:hover {
    background-color: #111A2B;
}

QTableView::item:alternate, QTableWidget::item:alternate {
    background-color: #0F1726;
}

QHeaderView::section {
    background-color: #111A2B;
    color: #A9B8D4;
    padding: 9px 12px;
    border: none;
    border-bottom: 1px solid #1A2940;
    font-weight: bold;
    font-size: 11px;
    letter-spacing: 0.5px;
}

/* ------------------------------------------------------------------------------
   BUTTONS (ELECTRIC BLUE PRIMARY + DARK NAVY SECONDARY)
   ------------------------------------------------------------------------------ */
QPushButton.primaryButton, QPushButton#btnPrimary, QPushButton#btn_scan_now, 
QPushButton#btn_details, QPushButton#btn_run_scan, QPushButton#save_scope_btn {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #168BFF, stop:1 #38A8FF);
    border: 1px solid #168BFF;
    color: #FFFFFF;
    padding: 8px 18px;
    border-radius: 6px;
    font-weight: bold;
    font-size: 13px;
}

QPushButton.primaryButton:hover, QPushButton#btnPrimary:hover, 
QPushButton#btn_scan_now:hover, QPushButton#btn_details:hover, QPushButton#btn_run_scan:hover,
QPushButton#save_scope_btn:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #38A8FF, stop:1 #60B8FF);
    border-color: #60B8FF;
}

QPushButton.primaryButton:pressed, QPushButton#btnPrimary:pressed, 
QPushButton#btn_scan_now:pressed, QPushButton#btn_details:pressed, QPushButton#btn_run_scan:pressed,
QPushButton#save_scope_btn:pressed {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #0D6ED4, stop:1 #168BFF);
}

QPushButton.primaryButton:disabled, QPushButton#btnPrimary:disabled, QPushButton#btn_scan_now:disabled {
    background: #111A2B;
    color: #71809A;
    border: 1px solid #1A2940;
}

QPushButton.secondaryButton {
    background-color: #111A2B;
    border: 1px solid #1A2940;
    color: #A9B8D4;
    padding: 7px 14px;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 600;
}

QPushButton.secondaryButton:hover {
    background-color: #17233A;
    border-color: #355B8A;
    color: #FFFFFF;
}

QPushButton.actionRedButton {
    background-color: rgba(255, 77, 103, 0.15);
    border: 1px solid #FF4D67;
    color: #FF4D67;
    padding: 7px 14px;
    border-radius: 6px;
    font-weight: bold;
}

QPushButton.actionRedButton:hover {
    background-color: rgba(255, 77, 103, 0.3);
}

/* ------------------------------------------------------------------------------
   INPUTS & FORM CONTROLS
   ------------------------------------------------------------------------------ */
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox {
    background-color: #0D1422;
    border: 1px solid #1A2940;
    border-radius: 6px;
    padding: 7px 12px;
    color: #FFFFFF;
    selection-background-color: #168BFF;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #168BFF;
}

QComboBox {
    background-color: #0D1422;
    border: 1px solid #1A2940;
    border-radius: 6px;
    padding: 6px 12px;
    color: #FFFFFF;
}

QComboBox:focus, QComboBox:hover {
    border-color: #355B8A;
}

QComboBox QAbstractItemView {
    background-color: #0D1422;
    border: 1px solid #1A2940;
    color: #FFFFFF;
    selection-background-color: #17233A;
    selection-color: #38A8FF;
    outline: none;
    padding: 4px;
}

/* ------------------------------------------------------------------------------
   LISTS & TREES
   ------------------------------------------------------------------------------ */
QListWidget, QTreeWidget {
    background-color: #0D1422;
    border: 1px solid #1A2940;
    border-radius: 6px;
    padding: 4px;
    color: #F4F7FF;
}

QListWidget::item, QTreeWidget::item {
    padding: 6px 8px;
    border-radius: 4px;
}

QListWidget::item:hover, QTreeWidget::item:hover {
    background-color: #111A2B;
}

QListWidget::item:selected, QTreeWidget::item:selected {
    background-color: #17233A;
    color: #FFFFFF;
    font-weight: bold;
    border: 1px solid #355B8A;
    border-left: 3px solid #168BFF;
}

/* ------------------------------------------------------------------------------
   SCROLLBARS
   ------------------------------------------------------------------------------ */
QScrollBar:vertical {
    border: none;
    background: #090F1C;
    width: 8px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #21334D;
    min-height: 20px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #168BFF, stop:1 #38A8FF);
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    border: none;
    background: none;
}

QScrollBar:horizontal {
    border: none;
    background: #090F1C;
    height: 8px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background: #21334D;
    min-width: 20px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #168BFF, stop:1 #38A8FF);
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    border: none;
    background: none;
}

/* ------------------------------------------------------------------------------
   TABS
   ------------------------------------------------------------------------------ */
QTabWidget::pane {
    border: 1px solid #1A2940;
    background-color: #0D1422;
    border-radius: 8px;
}

QTabBar::tab {
    background: #111A2B;
    border: 1px solid #1A2940;
    padding: 8px 16px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    margin-right: 3px;
    color: #71809A;
    font-weight: 600;
}

QTabBar::tab:selected {
    background: #17233A;
    border: 1px solid #355B8A;
    border-bottom: 2px solid #168BFF;
    color: #FFFFFF;
    font-weight: bold;
}

QTabBar::tab:hover {
    color: #F4F7FF;
}

/* ------------------------------------------------------------------------------
   PROGRESS BARS
   ------------------------------------------------------------------------------ */
QProgressBar {
    background-color: #0D1422;
    border: 1px solid #1A2940;
    border-radius: 4px;
    text-align: center;
    color: #FFFFFF;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #168BFF, stop:1 #38A8FF);
    border-radius: 3px;
}

/* ------------------------------------------------------------------------------
   DIALOGS & MESSAGES
   ------------------------------------------------------------------------------ */
QDialog, QMessageBox {
    background-color: #070B16;
    color: #F4F7FF;
}

QSplitter::handle {
    background-color: #1A2940;
    height: 4px;
    width: 4px;
}

QSplitter::handle:hover {
    background-color: #355B8A;
}

/* ------------------------------------------------------------------------------
   CHECKBOXES
   ------------------------------------------------------------------------------ */
QCheckBox {
    color: #F4F7FF;
    font-size: 13px;
    spacing: 6px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #1A2940;
    border-radius: 4px;
    background: #0D1422;
}

QCheckBox::indicator:hover {
    border-color: #355B8A;
}

QCheckBox::indicator:checked {
    background: #168BFF;
    border-color: #168BFF;
}
